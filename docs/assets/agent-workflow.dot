digraph AgentWorkflow {
  graph [
    rankdir=TB,
    bgcolor="#202124",
    pad=0.3,
    nodesep=0.4,
    ranksep=0.55,
    splines=ortho
  ];

  node [
    shape=box,
    style="rounded,filled",
    fillcolor="#20354D",
    color="#6FA8DC",
    fontcolor="#E6F1FF",
    fontname="DejaVu Sans",
    fontsize=12,
    margin="0.18,0.12",
    group=main
  ];

  edge [
    color="#9AA0A6",
    fontcolor="#D1D5DB",
    fontname="DejaVu Sans",
    fontsize=10,
    arrowsize=0.7,
    weight=10
  ];

  user_input [label="user_input"];
  dataset_validator [label="dataset_validator"];

  valid [
    label="Dataset\nvalid?",
    shape=diamond,
    style=filled,
    fillcolor="#352B45",
    color="#B6A0D1",
    fontcolor="#EDE2FA"
  ];

  config_generator [label="config_generator"];
  trainer [label="trainer"];
  monitor [label="monitor"];

  split [
    label="Decision split\nis test?",
    shape=diamond,
    style=filled,
    fillcolor="#352B45",
    color="#B6A0D1",
    fontcolor="#EDE2FA"
  ];

  test_checkpoint [
    label="test_checkpoint",
    group=test
  ];

  decision [
    label="decision\nStop condition\nreached?",
    shape=diamond,
    style=filled,
    fillcolor="#352B45",
    color="#B6A0D1",
    fontcolor="#EDE2FA"
  ];

  config_optimizer [
    label="config_optimizer",
    group=tune
  ];

  proposal [
    label="Optimization\nvalid?",
    group=proposal,
    shape=diamond,
    style=filled,
    fillcolor="#352B45",
    color="#B6A0D1",
    fontcolor="#EDE2FA"
  ];

  retries [
    label="Correction requests\nremaining?",
    group=proposal,
    shape=diamond,
    style=filled,
    fillcolor="#352B45",
    color="#B6A0D1",
    fontcolor="#EDE2FA"
  ];

  correct [
    label="Request corrected proposal\nwith exact validation error\n(up to 2 additional proposals)",
    group=correction
  ];

  onnx_exporter [
    label="onnx_exporter",
    fillcolor="#20362F",
    color="#71A28C",
    fontcolor="#D8EEE3"
  ];

  reporter [
    label="reporter",
    fillcolor="#20362F",
    color="#71A28C",
    fontcolor="#D8EEE3"
  ];

  end [
    label="End session",
    fillcolor="#20362F",
    color="#71A28C",
    fontcolor="#D8EEE3"
  ];

  user_input -> dataset_validator -> valid;

  valid -> config_generator [xlabel="Yes"];
  valid -> reporter [
    xlabel="No",
    constraint=false,
    weight=0
  ];

  config_generator -> trainer -> monitor -> split;

  split -> test_checkpoint [xlabel="Yes", weight=0];
  split -> decision [xlabel="No"];
  test_checkpoint -> decision [weight=0];

  decision -> config_optimizer [xlabel="No", weight=0];
  decision -> onnx_exporter [xlabel="Yes"];

  config_optimizer -> proposal;

  proposal -> trainer [
    xlabel="Yes: next attempt",
    constraint=false,
    weight=0
  ];

  proposal -> retries [xlabel="No"];
  retries -> correct [xlabel="Yes", weight=0];

  correct -> proposal [
    xlabel="Validate again",
    constraint=false,
    weight=0
  ];

  retries -> onnx_exporter [
    xlabel="No: stop with error",
    style=dashed
  ];

  onnx_exporter -> reporter -> end;
}
