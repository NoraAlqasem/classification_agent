# Copy this file to .env. Never commit your real API key.
OPENAI_API_KEY=replace_with_your_api_key
OPENAI_MODEL=gpt-4o

# Optional: set the endpoint and model for an OpenAI-compatible provider.
# OPENAI_API_BASE=https://your-provider.example/v1

LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=512
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2
LLM_RATE_LIMIT_MAX_WAIT_SECONDS=60

# Maximum changed hyperparameter keys per optimizer proposal; positive integer.
LLM_OPTIMIZATION_MAX_HYPERPARAMETERS=1

# Prompt compaction limits; each value must be a positive integer.
LLM_CONTEXT_HISTORY_ENTRIES=5
LLM_CONTEXT_RECENT_EXPERIMENTS=3
LLM_CONTEXT_MAX_ITEMS=3
LLM_CONTEXT_MAX_CLASSES_PER_HEAD=50

# Replace these with your local dataset paths and CSV label columns.
TRAIN_CSV=/path/to/train.csv
VAL_CSV=/path/to/val.csv
TEST_CSV=/path/to/test.csv
DATA_ROOT=/path/to/images
HEADS="make vehicle_type"

# test is the project default. Use val to tune on validation instead.
DECISION_SPLIT=test

# Alternative to individual CSV paths: a directory with the required splits.
# DATASET_PATH=/path/to/dataset
